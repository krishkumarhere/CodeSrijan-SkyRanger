[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=krish

ExecStart=/usr/local/bin/cloudflared tunnel run skyranger

Restart=always
RestartSec=5

StandardOutput=append:/home/krish/Desktop/CodeSrijan-SkyRanger/logs/cloudflared.log
StandardError=append:/home/krish/Desktop/CodeSrijan-SkyRanger/logs/cloudflared.err

[Install]
WantedBy=multi-user.target
