[Unit]
Description=Cloudflare Tunnel
After=network.target
Wants=network.target

[Service]
Type=simple
User=krish
ExecStart=/usr/local/bin/cloudflared tunnel run skyranger
Restart=always
RestartSec=10
StandardOutput=append:/var/log/skyranger/cloudflared.log
StandardError=append:/var/log/skyranger/cloudflared.err

[Install]
WantedBy=multi-user.target
